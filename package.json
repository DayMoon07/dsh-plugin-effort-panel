{
  "name": "dsh-plugin-effort-panel",
  "version": "0.4.7",
  "description": "Codex-style single-panel model and reasoning-effort picker for the DeepSeek Harness composer.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "reasoning-effort",
    "slider",
    "composer",
    "cordis"
  ],
  "engines": {
    "node": ">=22.19",
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DayMoon07/dsh-plugin-effort-panel.git"
  },
  "homepage": "https://github.com/DayMoon07/dsh-plugin-effort-panel#readme",
  "bugs": {
    "url": "https://github.com/DayMoon07/dsh-plugin-effort-panel/issues"
  },
  "author": "Aqua",
  "license": "MIT"
}
